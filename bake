#!/usr/bin/env bash

set -euo pipefail
trap 'printf "Error at line %s\n" "$LINENO" >&2' ERR

read -r -d '' DATI <<'EOF' || true
nucleo-h723zg sdk meta-toolchain public sh
EOF

build_all() {
    local FAILED=()

    exec 3<<< "$DATI"

    # shellcheck disable=SC2034  # outputdir/format are columns of the table shared with release
    while read -r -u 3 machine type image outputdir format; do
        export MACHINE="$machine"

        case "$type" in
            image)
            	continue
                ;;
            sdk)
            	if ! nice bitbake -k meta-toolchain; then
	                fail "bitbake failed: ${machine}/sdk (toolchain)"
	                continue
        	fi
                ;;
            *)
                printf 'Type unknown: %s\n' "$type" >&2
                exit 1
                ;;
        esac
    done

    exec 3<&-

    if (( ${#FAILED[@]} )); then
        printf 'Failed builds:\n' >&2
        printf '  %s\n' "${FAILED[@]}" >&2
        return 1
    fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    build_all
fi
